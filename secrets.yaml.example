# ==============================================================================
# ESPHome Secrets Example
# Скопіюйте цей файл як `secrets.yaml` та заповніть своїми параметрами:
# ==============================================================================

# WiFi credentials
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
domain: ".local"

# ESPHome Native API Key (згенеруйте новий або візьміть з ESPHome)
api_key: "GENERATE_YOUR_OWN_KEY_HERE="

# OTA & Fallback passwords
ota_password: "YOUR_SECURE_OTA_PASSWORD"
fallback_password: "YOUR_FALLBACK_PASSWORD"

# Deye Inverter secrets
pv_inverter_api_key: "GENERATE_YOUR_OWN_KEY_HERE="
pv_inverter_ota_password: "YOUR_SECURE_OTA_PASSWORD"
pv_inverter_fallback_password: "YOUR_FALLBACK_PASSWORD"

# MQTT (якщо використовується)
mqtt_host: "192.168.1.100"
mqtt_username: "mqtt_user"
mqtt_password: "mqtt_password"
